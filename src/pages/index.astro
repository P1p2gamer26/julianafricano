---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import TechStack from '../components/TechStack.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <main>
    <Hero />
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Python</span><span>Django</span><span>React</span><span>Spring Boot</span>
        <span>YOLOv8</span><span>OpenCV</span><span>PostgreSQL</span><span>Docker</span>
        <span>TypeScript</span><span>Machine Learning</span><span>RTSP</span><span>LLMs</span>
        <span>Python</span><span>Django</span><span>React</span><span>Spring Boot</span>
        <span>YOLOv8</span><span>OpenCV</span><span>PostgreSQL</span><span>Docker</span>
        <span>TypeScript</span><span>Machine Learning</span><span>RTSP</span><span>LLMs</span>
      </div>
    </div>
    <About />
    <TechStack />
    <Projects />
    <Experience />
    <Contact />
  </main>
</Base>