---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="404" description="Página no encontrada">
  <main>
    <section class="hero" style="min-height:70vh">
      <div class="container" style="text-align:center">
        <h1>404 — Página no encontrada</h1>
        <p style="color:var(--muted);margin:18px auto 30px;max-width:420px">
          El dato que buscas no existe en esta porción del universo.
        </p>
        <a class="btn btn--primary" href={`${site.base}/`}>Volver al inicio</a>
      </div>
    </section>
  </main>
</Base>