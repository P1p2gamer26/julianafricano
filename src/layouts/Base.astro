---
import '../styles/global.css';
import { site } from '../data/site';
import { translations, LANGUAGES, DEFAULT_LANG } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const metaTitle = title ? `${title} — ${site.alias}` : `${site.name} — ${site.role}`;
const metaDesc =
  description ??
  'Portafolio profesional de Julian Felipe Africano Preciado: Ingeniero de Sistemas, desarrollador Full-Stack e IA. Plataformas en producción como SysteFarma. Bogotá, Colombia.';

const baseUrl = `${site.host}${site.base}`;
const rawPath = Astro.url.pathname.replace(/\/+$/, '').replace(/(^|\/)index\.html?$/, '$1') || '';
const canonical = `${site.host}${rawPath}/`;
const ogImage = `${baseUrl}/og.png`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.alias,
  jobTitle: site.role,
  url: baseUrl,
  address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
  knowsAbout: [
    'Ingeniería de Software',
    'Desarrollo Full-Stack',
    'Inteligencia Artificial',
    'Visión por Computadora',
    'DevOps',
  ],
  sameAs: [site.github, site.linkedin, site.instagram],
};
---

<!doctype html>
<html lang="es-CO" data-theme="azul">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDesc} />
    <meta name="theme-color" content="#0a1220" />
    <meta name="author" content={site.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:site_name" content={site.alias} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={metaTitle} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${site.base}/favicon.svg`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <nav class="nav" id="nav" data-i18n-aria="nav.navAria" aria-label="Navegación principal">
      <div class="nav__inner">
        <a class="nav__logo" href="#inicio" data-i18n-aria="nav.logoAria" aria-label="Inicio">
          <span class="nav__logo-mark">JA</span>
          <span>{site.alias}</span>
        </a>

        <ul class="nav__links" id="navLinks">
          <li><a class="nav__link" href="#inicio" data-i18n="nav.inicio">Inicio</a></li>
          <li><a class="nav__link" href="#sobre-mi" data-i18n="nav.sobre">Sobre mí</a></li>
          <li><a class="nav__link" href="#stack" data-i18n="nav.stack">Stack</a></li>
          <li><a class="nav__link" href="#proyectos" data-i18n="nav.proyectos">Proyectos</a></li>
          <li><a class="nav__link" href="#trayectoria" data-i18n="nav.trayectoria">Trayectoria</a></li>
          <li>
            <a class="btn btn--primary btn--sm nav__cta" href="#contacto" data-i18n="nav.contacto">Contáctame</a>
          </li>
        </ul>

        <div class="nav__themes" role="group" data-i18n-aria="nav.themeGroup" aria-label="Cambiar tema">
          <select class="lang-sel" data-lang-sel data-i18n-aria="lang.selectAria" aria-label="Cambiar idioma">
            {
              LANGUAGES.map((l) => (
                <option value={l.code}>{l.label}</option>
              ))
            }
          </select>
          <button class="theme-btn" data-theme-sel="azul" data-i18n-aria="theme.azul" data-i18n-title="theme.azul" aria-label="Tema azul" title="Azul"></button>
          <button class="theme-btn" data-theme-sel="claro" data-i18n-aria="theme.claro" data-i18n-title="theme.claro" aria-label="Tema claro" title="Claro"></button>
          <button class="theme-btn" data-theme-sel="oscuro" data-i18n-aria="theme.oscuro" data-i18n-title="theme.oscuro" aria-label="Tema oscuro" title="Oscuro"></button>
        </div>

        <button class="nav__burger" id="burger" data-i18n-aria="nav.menuOpen" aria-label="Abrir menú">
          <span></span>
        </button>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="container footer__inner">
        <span>© {new Date().getFullYear()} Julian Felipe Africano Preciado.</span>
        <span>
          <span data-i18n="footer.built">Hecho con</span> <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> ·
          <a href={site.github} target="_blank" rel="noopener">GitHub</a> ·
          <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
          <a href={site.talento} target="_blank" rel="noopener">Talento Javeriano</a>
        </span>
      </div>
    </footer>

    <script is:inline type="application/json" id="i18n-dict" set:html={JSON.stringify({ translations, name: site.name })}></script>

    <script is:inline>
      (function () {
        const payload = JSON.parse(document.getElementById('i18n-dict').textContent);
        const DICT = payload.translations;
        const NAME = payload.name;
        const LANGS = ['es', 'en'];
        const TAGS = { es: 'es-CO', en: 'en' };

        function readSaved() {
          try {
            const saved = localStorage.getItem('lang');
            if (saved && LANGS.indexOf(saved) !== -1) return saved;
          } catch (e) {}
          const nav = (navigator.language || 'es').toLowerCase().slice(0, 2);
          return LANGS.indexOf(nav) !== -1 ? nav : 'es';
        }

        function fmt(tpl, vars) {
          return String(tpl).replace(/\{(\w+)\}/g, (_, k) => (vars && vars[k] !== undefined ? vars[k] : ''));
        }

        function applyLang(lang) {
          window.__I18N = { lang: lang, t: (key) => (DICT[key] && DICT[key][lang]) || '' };
          document.documentElement.lang = TAGS[lang] || lang;
          const L = window.__I18N.t;

          document.querySelectorAll('[data-i18n]').forEach((el) => {
            const val = L(el.dataset.i18n);
            if (!val) return;
            if (el.hasAttribute('data-i18n-html')) el.innerHTML = val;
            else el.textContent = fmt(val, el.dataset);
          });
          document.querySelectorAll('[data-i18n-ph]').forEach((el) => {
            const val = L(el.dataset.i18nPh);
            if (val) el.placeholder = val;
          });
          document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
            const val = L(el.dataset.i18nAria);
            if (val) el.setAttribute('aria-label', fmt(val, el.dataset));
          });
          document.querySelectorAll('[data-i18n-title]').forEach((el) => {
            const val = L(el.dataset.i18nTitle);
            if (val) el.setAttribute('title', val);
          });
          document.querySelectorAll('[data-i18n-alt]').forEach((el) => {
            const val = L(el.dataset.i18nAlt);
            if (val) el.setAttribute('alt', fmt(val, el.dataset));
          });

          const role = L('meta.role');
          const title = fmt(L('meta.title'), { name: NAME, role: role });
          if (title) {
            document.title = title;
            const set = (sel, val) => {
              const m = document.querySelector(sel);
              if (m) m.setAttribute('content', val);
            };
            set('meta[name="description"]', L('meta.desc'));
            set('meta[property="og:title"]', title);
            set('meta[property="og:description"]', L('meta.desc'));
            set('meta[name="twitter:title"]', title);
            set('meta[name="twitter:description"]', L('meta.desc'));
          }

          const sel = document.querySelector('[data-lang-sel]');
          if (sel) sel.value = lang;
        }

        const lang = readSaved();
        try {
          localStorage.setItem('lang', lang);
        } catch (e) {}

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => applyLang(lang));
        } else {
          applyLang(lang);
        }

        document.addEventListener('change', (e) => {
          const target = e.target;
          if (target && target.matches && target.matches('[data-lang-sel]')) {
            const next = target.value;
            try {
              localStorage.setItem('lang', next);
            } catch (err) {}
            applyLang(next);
          }
        });
      })();
    </script>

    <script>
      const nav = document.getElementById('nav');
      const burger = document.getElementById('burger');
      const links = document.getElementById('navLinks');

      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 20);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      burger.addEventListener('click', () => {
        const open = links.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', String(open));
      });

      links.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => links.classList.remove('is-open'))
      );

      /* Scroll-reveal */
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal, .project-card').forEach((el) => {
        io.observe(el);
        el.addEventListener(
          'animationend',
          () => {
            el.classList.remove('is-visible');
            el.classList.add('reveal-done');
          },
          { once: true }
        );
      });

      /* Temas: azul (default), claro, oscuro */
      const root = document.documentElement;
      const THEMES = ['azul', 'claro', 'oscuro'];
      const saved = localStorage.getItem('theme');
      if (saved && THEMES.includes(saved)) {
        root.dataset.theme = saved;
      } else {
        root.dataset.theme = 'azul';
        localStorage.setItem('theme', 'azul');
      }

      const paintTheme = () => {
        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          const colors: Record<string, string> = {
            azul: '#0a1220',
            claro: '#f7f6fb',
            oscuro: '#0a0c10',
          };
          meta.setAttribute('content', colors[root.dataset.theme as string] || colors.azul);
        }
        document.querySelectorAll<HTMLElement>('[data-theme-sel]').forEach((b) => {
          b.classList.toggle('is-active', b.dataset.themeSel === root.dataset.theme);
        });
      };

      document.querySelectorAll<HTMLElement>('[data-theme-sel]').forEach((btn) =>
        btn.addEventListener('click', () => {
          root.dataset.theme = btn.dataset.themeSel as string;
          localStorage.setItem('theme', root.dataset.theme);
          paintTheme();
        })
      );
      paintTheme();
    </script>
  </body>
</html>