---
import { skillGroups } from '../data/skills';
import { ICONS } from '../icons';
---

<section class="section section--alt" id="stack">
  <div class="container">
    <span class="eyebrow reveal">Stack</span>
    <h2 class="section-title reveal">Tecnologías con las que <span class="grad-text">construyo</span></h2>
    <p class="section-sub reveal">
      Del frontend al modelo de visión, de la base de datos al servidor en
      producción. Un stack para resolver problemas de punta a punta.
    </p>

    <div class="skills__grid">
      {
        skillGroups.map((group, gi) => (
          <div
            class="skill-group reveal"
            style={`--shift: ${gi * 22}deg; transition-delay: ${gi * 60}ms`}
          >
            <div class="skill-group__head">
              <span class="skill-group__icon" aria-hidden="true" set:html={ICONS[group.icon]}></span>
              <div class="skill-group__title">
                <h3>{group.title}</h3>
                <span class="skill-group__count">{group.items.length} habilidades</span>
              </div>
            </div>
            <div class="skill-group__tags">
              {group.items.map((it) => (
                <span class="skill-tag">{it.name}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>