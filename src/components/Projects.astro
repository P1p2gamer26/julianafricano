---
import { projects } from '../data/projects';
import { img } from '../data/site';
import { GITHUB_ICON, EXTERNAL_ICON } from '../icons';
---

<section class="section section--alt" id="proyectos">
  <div class="container">
    <span class="eyebrow reveal">Proyectos</span>
    <h2 class="section-title reveal">Trabajo que ya está <span class="grad-text">rodando</span></h2>
    <p class="section-sub reveal">
      Productos en producción y misiones de IA aplicada. Capturas reales, no mockups.
    </p>

    <div class="projects__grid" id="projectsGrid">
      {
        projects.map((p, idx) => (
          <article
            class="project-card"
            style={`transition-delay: ${(idx % 3) * 70}ms`}
          >
            <div class="project-card__top">
              <span class="project-card__icon" aria-hidden="true">{p.name.slice(0, 2).toUpperCase()}</span>
              <span class="badge badge--prod">{p.category === 'ai' ? 'IA & Visión' : p.category === 'academic' ? 'Académico' : 'Producción'}</span>
            </div>

            <h3>{p.name}</h3>
            <p class="mono" style="font-size:.8rem;color:var(--muted-2);margin-bottom:8px">{p.tagline}</p>
            <p class="project-card__desc">{p.desc}</p>

            {
              p.gallery && p.gallery.length > 0 && (
                <div class="gallery" data-gallery data-count={p.gallery.length}>
                  <div class="gallery__viewport">
                    <div class="gallery__track">
                      {p.gallery.map((g, gi) => (
                        <div class="gallery__slide">
                          <img
                            src={img(g)}
                            alt={`Captura ${gi + 1} de ${p.gallery.length} del proyecto ${p.name}`}
                            loading="lazy"
                            width="400"
                            height="300"
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                  <button class="gallery__nav gallery__nav--prev" aria-label="Captura anterior" disabled>‹</button>
                  <button class="gallery__nav gallery__nav--next" aria-label="Captura siguiente">›</button>
                  <span class="gallery__count">
                    <b class="gallery__cur">1</b> / {p.gallery.length}
                  </span>
                </div>
              )
            }

            <div class="project-card__links">
              {p.repo && (
                <a href={p.repo} target="_blank" rel="noopener" aria-label={`Código en GitHub: ${p.name}`}>
                  <span set:html={GITHUB_ICON} /> Repo
                </a>
              )}
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener">
                  <span set:html={EXTERNAL_ICON} /> Sitio
                </a>
              )}
            </div>

            <div class="skill-group__tags" style="margin-top:auto;padding-top:16px">
              {p.tech.slice(0, 5).map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Visor de capturas">
    <button class="lightbox__close" id="lightboxClose" aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Captura anterior">‹</button>
    <figure class="lightbox__figure">
      <img id="lightboxImg" alt="" />
      <figcaption id="lightboxCaption"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Captura siguiente">›</button>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.project-card');
  let lightboxOpen = false;

  /* Tilt suave en las tarjetas */
  cards.forEach((card) => {
    card.addEventListener('mousemove', (ev: MouseEvent) => {
      if (window.matchMedia('(hover: none)').matches) return;
      const r = card.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      card.style.transform = `perspective(900px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  /* Carrusel por galería */
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gal) => {
    const slides = gal.querySelectorAll<HTMLElement>('.gallery__slide');
    const track = gal.querySelector('.gallery__track') as HTMLElement;
    const prev = gal.querySelector('.gallery__nav--prev') as HTMLButtonElement;
    const next = gal.querySelector('.gallery__nav--next') as HTMLButtonElement;
    const cur = gal.querySelector('.gallery__cur') as HTMLElement;
    const count = slides.length;
    let curIdx = 0;
    let playing = count > 1;
    let timer: number | undefined;

    const update = () => {
      if (cur) cur.textContent = String(curIdx + 1);
      if (track) track.style.transform = `translateX(-${curIdx * 100}%)`;
      if (prev) prev.disabled = curIdx === 0;
      if (next) next.disabled = curIdx === count - 1;
    };

    const auto = () => {
      if (!playing || lightboxOpen) return;
      curIdx = (curIdx + 1) % count;
      update();
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(auto, 4000);
    };
    const stop = () => window.clearInterval(timer);

    const go = (to: number) => {
      stop();
      curIdx = to;
      update();
      start();
    };

    prev?.addEventListener('click', () => go(curIdx > 0 ? curIdx - 1 : count - 1));
    next?.addEventListener('click', () => go(curIdx < count - 1 ? curIdx + 1 : 0));

    gal.addEventListener('mouseenter', () => (playing = false));
    gal.addEventListener('mouseleave', () => {
      playing = true;
      start();
    });

    gal.addEventListener('click', (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest('.gallery__nav');
      if (btn) return;
      stop();
      playing = false;
      openLightbox(gal, curIdx, e);
    });

    update();
    start();
  });

  /* Lightbox de capturas */
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lbCap = document.getElementById('lightboxCaption') as HTMLElement;
  let items: string[] = [];
  let caps: string[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;
  const lbFocusables = () =>
    [document.getElementById('lightboxClose'), document.getElementById('lightboxPrev'), document.getElementById('lightboxNext')].filter(
      (el): el is HTMLElement => !!el
    );

  const openLightbox = (gal: HTMLElement, i: number, ev?: MouseEvent) => {
    const srcs = [...gal.querySelectorAll<HTMLImageElement>('.gallery__slide img')].map((im) => im.getAttribute('src') || '');
    const alts = [...gal.querySelectorAll<HTMLImageElement>('.gallery__slide img')].map((im) => im.alt);
    items = srcs;
    caps = alts;
    lastFocused = (ev?.target as HTMLElement) || (document.activeElement as HTMLElement | null);
    current = Math.min(i, items.length - 1);
    show();
  };
  const show = () => {
    lbImg.src = items[current];
    lbImg.alt = caps[current] || '';
    lbCap.textContent = caps[current] || '';
    lb.hidden = false;
    lightboxOpen = true;
    document.body.style.overflow = 'hidden';
    (document.getElementById('lightboxClose') as HTMLElement)?.focus();
  };
  const close = () => {
    lb.hidden = true;
    lightboxOpen = false;
    document.body.style.overflow = '';
    lastFocused?.focus();
  };
  const step = (d: number) => {
    current = (current + d + items.length) % items.length;
    show();
  };

  document.getElementById('lightboxClose')?.addEventListener('click', close);
  document.getElementById('lightboxPrev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e: MouseEvent) => {
    if (e.target === lb || e.target === lbImg) close();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'Tab') {
      const els = lbFocusables();
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>