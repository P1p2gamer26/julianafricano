---
import { projects } from '../data/projects';
import { img } from '../data/site';
import { GITHUB_ICON, EXTERNAL_ICON } from '../icons';

const filters = [
  { id: 'all', label: 'Todos' },
  { id: 'prod', label: 'Producción' },
  { id: 'ai', label: 'IA & Visión' },
];

const badgeClass: Record<string, string> = {
  prod: 'badge--prod',
  ai: 'badge--ai',
};

const badgeLabel: Record<string, string> = {
  prod: 'Producción',
  ai: 'IA & Visión',
};
---

<section class="section section--alt" id="proyectos">
  <div class="container">
    <span class="eyebrow reveal">Proyectos</span>
    <h2 class="section-title reveal">Trabajo que ya está <span class="grad-text">rodando</span></h2>
    <p class="section-sub reveal">
      Productos en producción y misiones de IA aplicada. Capturas reales, no mockups.
    </p>

    <div class="projects__filter reveal" role="group" aria-label="Filtrar proyectos">
      {filters.map((f) => (
        <button
          class={`filter-btn${f.id === 'all' ? ' is-active' : ''}`}
          data-filter={f.id}
        >
          {f.label}
        </button>
      ))}
    </div>

    <div class="projects__grid" id="projectsGrid">
      {
        projects.map((p, idx) => (
          <article
            class={`project-card${p.featured ? ' project-card--feature' : ''}`}
            data-category={p.category}
            style={`transition-delay: ${(idx % 3) * 70}ms`}
          >
            <div class="project-card__top">
              <span class="project-card__icon" aria-hidden="true">{p.name.slice(0, 2).toUpperCase()}</span>
              <span class={`badge ${badgeClass[p.category]}`}>{badgeLabel[p.category]}</span>
            </div>

            <h3>{p.name}</h3>
            <p class="mono" style="font-size:.8rem;color:var(--muted-2);margin-bottom:8px">{p.tagline}</p>
            <p class="project-card__desc">{p.desc}</p>

            {
              p.gallery && p.gallery.length > 0 && (
                <div class="gallery" data-gallery>
                  {p.gallery.slice(0, 4).map((g, gi) => (
                    <button
                      class="gallery__item"
                      data-src={img(g)}
                      data-caption={`${p.name} — captura ${gi + 1}`}
                      aria-label={`Ver captura ${gi + 1} de ${p.name}`}
                    >
                      <img src={img(g)} alt={`Captura ${gi + 1} del proyecto ${p.name}`} loading="lazy" width="400" height="300" />
                      <span class="gallery__more">+{Math.max(p.gallery.length - 4, 0)}</span>
                    </button>
                  ))}
                </div>
              )
            }

            <div class="project-card__links">
              {p.repo && (
                <a href={p.repo} target="_blank" rel="noopener" aria-label={`Código en GitHub: ${p.name}`}>
                  <span set:html={GITHUB_ICON} /> Repo
                </a>
              )}
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener">
                  <span set:html={EXTERNAL_ICON} /> Sitio
                </a>
              )}
            </div>

            <div class="skill-group__tags" style="margin-top:16px">
              {p.tech.slice(0, 5).map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Visor de capturas">
    <button class="lightbox__close" id="lightboxClose" aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Captura anterior">‹</button>
    <figure class="lightbox__figure">
      <img id="lightboxImg" alt="" />
      <figcaption id="lightboxCaption"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Captura siguiente">›</button>
  </div>
</section>

<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.project-card');

  btns.forEach((btn) =>
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const filter = btn.dataset.filter;

      cards.forEach((card) => {
        const cat = card.dataset.category;
        const show = filter === 'all' || cat === filter;
        card.style.display = show ? '' : 'none';
        if (show) {
          requestAnimationFrame(() => card.classList.add('is-visible'));
        }
      });
    })
  );

  /* Tilt suave en las tarjetas */
  cards.forEach((card) => {
    card.addEventListener('mousemove', (ev: MouseEvent) => {
      if (window.matchMedia('(hover: none)').matches) return;
      const r = card.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      card.style.transform = `perspective(900px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
    });
  });

  /* Lightbox de capturas */
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lbCap = document.getElementById('lightboxCaption') as HTMLElement;
  let items: string[] = [];
  let caps: string[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;
  const lbFocusables = () =>
    [document.getElementById('lightboxClose'), document.getElementById('lightboxPrev'), document.getElementById('lightboxNext')].filter(
      (el): el is HTMLElement => !!el
    );

  const open = (i: number) => {
    current = i;
    lastFocused = document.activeElement as HTMLElement | null;
    lbImg.src = items[i];
    lbImg.alt = caps[i];
    lbCap.textContent = caps[i];
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    (document.getElementById('lightboxClose') as HTMLElement)?.focus();
  };
  const close = () => {
    lb.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
  };
  const step = (d: number) => {
    current = (current + d + items.length) % items.length;
    lbImg.src = items[current];
    lbImg.alt = caps[current];
    lbCap.textContent = caps[current];
  };

  document.querySelectorAll<HTMLElement>('.gallery__item').forEach((btn) => {
    btn.addEventListener('click', () => {
      const gal = btn.closest('[data-gallery]') as HTMLElement | null;
      if (!gal) return;
      const its = gal.querySelectorAll<HTMLElement>('.gallery__item');
      items = [...its].map((b) => b.dataset.src as string);
      caps = [...its].map((b) => b.dataset.caption as string);
      open(its.length > 0 && [...its].indexOf(btn) > -1 ? [...its].indexOf(btn) : 0);
    });
  });

  document.getElementById('lightboxClose')?.addEventListener('click', close);
  document.getElementById('lightboxPrev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e: MouseEvent) => {
    if (e.target === lb || e.target === lbImg) close();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'Tab') {
      const els = lbFocusables();
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>