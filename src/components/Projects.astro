---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { GITHUB_ICON, EXTERNAL_ICON } from '../icons';
---

<section class="section section--alt" id="proyectos">
  <div class="container">
    <span class="eyebrow reveal" data-i18n="projects.eyebrow">Proyectos</span>
    <h2 class="section-title reveal" data-i18n="projects.title" data-i18n-html>Trabajo que ya está <span class="grad-text">rodando</span></h2>
    <p class="section-sub reveal" data-i18n="projects.subtitle">
      Productos en producción y misiones de IA aplicada. Capturas reales, no mockups.
    </p>

    <div class="projects__grid" id="projectsGrid">
      {
        projects.map((p, idx) => (
          <article
            class="project-card"
            style={`--card-delay: ${(idx % 3) * 70}ms`}
          >
            <div class="project-card__inner">
              <div class="project-card__top">
                <span class="project-card__icon" aria-hidden="true">{p.name.slice(0, 2).toUpperCase()}</span>
                <span class="badge badge--prod" data-i18n={p.category === 'ai' ? 'projects.badge.ai' : 'projects.badge.prod'}>{p.category === 'ai' ? 'IA & Visión' : 'Producción'}</span>
              </div>

              <h3>{p.name}</h3>
              <p class="mono" style="font-size:.8rem;color:var(--muted-2);margin-bottom:8px" data-i18n={`projects.${idx}.tagline`}>{p.tagline}</p>
              <p class="project-card__desc" data-i18n={`projects.${idx}.desc`}>{p.desc}</p>

              {
                p.gallery && p.gallery.length > 0 && (
                  <div class="gallery" data-gallery data-count={p.gallery.length}>
                    <div class="gallery__viewport">
                      <div class="gallery__track">
                        {p.gallery.map((g, gi) => (
                          <div class="gallery__slide">
                            <Image
                              src={g}
                              alt={`Captura ${gi + 1} de ${p.gallery.length} del proyecto ${p.name}`}
                              data-i18n-alt="projects.capture"
                              data-n={gi + 1}
                              data-total={p.gallery.length}
                              data-name={p.name}
                              data-full={g.src}
                              widths={[400, 800]}
                              sizes="(max-width: 700px) 100vw, 400px"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                        ))}
                      </div>
                    </div>
                    <button class="gallery__nav gallery__nav--prev" data-i18n-aria="projects.prev" aria-label="Captura anterior" disabled>‹</button>
                    <button class="gallery__nav gallery__nav--next" data-i18n-aria="projects.next" aria-label="Captura siguiente">›</button>
                    {p.gallery.length > 1 && (
                      <button type="button" class="gallery__toggle" data-i18n-aria="projects.pause" aria-label="Pausar carrusel" aria-pressed="false">
                        <span class="gallery__toggle-icon" aria-hidden="true">❚❚</span>
                      </button>
                    )}
                    <span class="gallery__count">
                      <b class="gallery__cur">1</b> / {p.gallery.length}
                    </span>
                  </div>
                )
              }

              <div class="project-card__links">
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noopener" aria-label={`Código en GitHub: ${p.name}`} data-i18n-aria="projects.repoAria" data-name={p.name}>
                    <span set:html={GITHUB_ICON} /> Repo
                  </a>
                )}
                {p.url && (
                  <a href={p.url} target="_blank" rel="noopener">
                    <span set:html={EXTERNAL_ICON} /> <span data-i18n="projects.url">Sitio</span>
                  </a>
                )}
                {p.slug && p.case && (
                  <a href={`${site.base}/proyectos/${p.slug}/`} data-i18n="projects.caseStudy">
                    Caso de estudio →
                  </a>
                )}
              </div>

              <div class="skill-group__tags" style="margin-top:auto;padding-top:16px">
                {p.tech.slice(0, 5).map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" data-i18n-aria="projects.lightbox.aria" aria-label="Visor de capturas">
    <button class="lightbox__close" id="lightboxClose" data-i18n-aria="projects.close" aria-label="Cerrar visor">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" data-i18n-aria="projects.prev" aria-label="Captura anterior">‹</button>
    <figure class="lightbox__figure">
      <img id="lightboxImg" alt="" />
      <figcaption id="lightboxCaption"></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" data-i18n-aria="projects.next" aria-label="Captura siguiente">›</button>
  </div>
</section>

<script>
  const cards = document.querySelectorAll('.project-card');
  let lightboxOpen = false;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const canHover = () => window.matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches;

  const t = (key: string): string => {
    const i18n = (window as unknown as { __I18N?: { t: (k: string) => string } }).__I18N;
    return (i18n && i18n.t(key)) || '';
  };

  /* Tilt suave en las tarjetas */
  cards.forEach((card) => {
    const tilt = card.querySelector('.project-card__inner') as HTMLElement | null;
    if (!tilt) return;
    card.addEventListener('mousemove', (ev: MouseEvent) => {
      if (!canHover()) return;
      const r = card.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `perspective(900px) rotateY(${x * 5}deg) rotateX(${-y * 5}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', () => {
      tilt.style.transform = '';
    });
  });

  /* Carrusel por galería */
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gal) => {
    const slides = gal.querySelectorAll<HTMLElement>('.gallery__slide');
    const track = gal.querySelector('.gallery__track') as HTMLElement;
    const prev = gal.querySelector('.gallery__nav--prev') as HTMLButtonElement;
    const next = gal.querySelector('.gallery__nav--next') as HTMLButtonElement;
    const toggle = gal.querySelector('.gallery__toggle') as HTMLButtonElement | null;
    const cur = gal.querySelector('.gallery__cur') as HTMLElement;
    const count = slides.length;
    let curIdx = 0;
    let userPaused = reduceMotion.matches;
    let hovered = false;
    let timer: number | undefined;

    const update = () => {
      if (cur) cur.textContent = String(curIdx + 1);
      if (track) track.style.transform = `translateX(-${curIdx * 100}%)`;
      if (prev) prev.disabled = curIdx === 0;
      if (next) next.disabled = curIdx === count - 1;
    };

    const paintToggle = () => {
      if (!toggle) return;
      toggle.setAttribute('aria-pressed', String(userPaused));
      const label = userPaused ? t('projects.play') || 'Reproducir carrusel' : t('projects.pause') || 'Pausar carrusel';
      toggle.setAttribute('aria-label', label);
      toggle.querySelector('.gallery__toggle-icon')!.textContent = userPaused ? '▶' : '❚❚';
    };

    const stop = () => window.clearInterval(timer);

    const start = () => {
      stop();
      if (userPaused || hovered || document.hidden || lightboxOpen || count < 2) return;
      timer = window.setInterval(() => {
        curIdx = (curIdx + 1) % count;
        update();
      }, 4000);
    };

    const go = (to: number) => {
      curIdx = to;
      update();
      start();
    };

    prev?.addEventListener('click', () => go(curIdx > 0 ? curIdx - 1 : count - 1));
    next?.addEventListener('click', () => go(curIdx < count - 1 ? curIdx + 1 : 0));

    toggle?.addEventListener('click', () => {
      userPaused = !userPaused;
      paintToggle();
      start();
    });

    gal.addEventListener('mouseenter', () => {
      hovered = true;
      start();
    });
    gal.addEventListener('mouseleave', () => {
      hovered = false;
      start();
    });
    gal.addEventListener('focusin', () => {
      hovered = true;
      start();
    });
    gal.addEventListener('focusout', (e: FocusEvent) => {
      if (gal.contains(e.relatedTarget as Node)) return;
      hovered = false;
      start();
    });
    document.addEventListener('visibilitychange', start);
    gal.addEventListener('carousel:resume', start);
    reduceMotion.addEventListener('change', () => {
      userPaused = reduceMotion.matches || userPaused;
      paintToggle();
      start();
    });

    gal.addEventListener('click', (e: MouseEvent) => {
      const btn = (e.target as HTMLElement).closest('.gallery__nav, .gallery__toggle');
      if (btn) return;
      openLightbox(gal, curIdx, e);
    });

    update();
    paintToggle();
    start();
  });

  /* Lightbox de capturas */
  const lb = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lbCap = document.getElementById('lightboxCaption') as HTMLElement;
  let items: string[] = [];
  let caps: string[] = [];
  let current = 0;
  let lastFocused: HTMLElement | null = null;
  const lbFocusables = () =>
    [document.getElementById('lightboxClose'), document.getElementById('lightboxPrev'), document.getElementById('lightboxNext')].filter(
      (el): el is HTMLElement => !!el
    );

  const openLightbox = (gal: HTMLElement, i: number, ev?: MouseEvent) => {
    const srcs = [...gal.querySelectorAll<HTMLImageElement>('.gallery__slide img')].map((im) => im.dataset.full || im.getAttribute('src') || '');
    const alts = [...gal.querySelectorAll<HTMLImageElement>('.gallery__slide img')].map((im) => im.alt);
    items = srcs;
    caps = alts;
    lastFocused = (ev?.target as HTMLElement) || (document.activeElement as HTMLElement | null);
    current = Math.min(i, items.length - 1);
    show();
  };
  const show = () => {
    lbImg.src = items[current];
    lbImg.alt = caps[current] || '';
    lbCap.textContent = caps[current] || '';
    lb.hidden = false;
    lightboxOpen = true;
    document.body.style.overflow = 'hidden';
    (document.getElementById('lightboxClose') as HTMLElement)?.focus();
  };
  const close = () => {
    lb.hidden = true;
    lightboxOpen = false;
    document.body.style.overflow = '';
    lastFocused?.focus();
    document.querySelectorAll('[data-gallery]').forEach((gal) => gal.dispatchEvent(new Event('carousel:resume')));
  };
  const step = (d: number) => {
    current = (current + d + items.length) % items.length;
    show();
  };

  document.getElementById('lightboxClose')?.addEventListener('click', close);
  document.getElementById('lightboxPrev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => step(1));
  lb.addEventListener('click', (e: MouseEvent) => {
    if (e.target === lb || e.target === lbImg) close();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'Tab') {
      const els = lbFocusables();
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>