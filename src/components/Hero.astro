---
import { site } from '../data/site';
---

<section class="hero" id="inicio">
  <div class="hero__glow hero__glow--1" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--2" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__status">Disponible para nuevos proyectos</span>

      <p class="hero__kicker">
        <span class="mono">
          <span class="prompt">$</span> whoami
        </span>
        <br />
        <span class="grad-text mono">Julian Felipe Africano Preciado</span>
      </p>

      <h1 class="hero__title">
        Ingeniero de <span class="grad-text">Sistemas</span>
        <br />
        Full-Stack e <span class="grad-text">Inteligencia Artificial</span>
      </h1>

      <p class="hero__lead">
        Construyo productos de punta a punta y he desplegado
        <strong>plataformas en producción</strong> como SysteFarma, usada por
        droguerías colombianas. De la idea al deploy en producción.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#proyectos">Ver proyectos</a>
        <a class="btn" href={`${site.base}/CV-Julian-Africano.pdf`} download>Descargar CV</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href="#contacto">Contáctame</a>
      </div>

      <div class="hero__meta">
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z" /><circle cx="12" cy="10" r="2.6" /></svg>
          {site.location}
        </span>
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1" /><path d="M22 4 12 14l-3-3" /></svg>
          Ingeniería · IA · Visión por computadora
        </span>
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 8l-9 5-9-5V6l9 5 9-5v2Z" /><path d="M3 6h18v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" /></svg>
          <a href="#contacto">Escríbeme por el formulario</a>
        </span>
      </div>
    </div>

    <div class="hero__card">
      <div class="hero__photo">
        <img
          src={`${site.base}/perfil.jpg`}
          alt="Retrato de Julian Felipe Africano Preciado"
          width="800"
          height="800"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>