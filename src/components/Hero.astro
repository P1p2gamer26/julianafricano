---
import { site } from '../data/site';
---

<section class="hero" id="inicio">
  <div class="hero__glow hero__glow--1" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--2" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__status">Disponible para nuevos proyectos</span>

      <p class="hero__kicker">
        <span class="mono">
          <span class="prompt">$</span> whoami
        </span>
        <br />
        <span class="grad-text mono">Julian Felipe Africano Preciado</span>
      </p>

      <h1 class="hero__title">
        Ingeniero de <span class="grad-text">Sistemas</span>
        <br />
        Full-Stack e <span class="grad-text">Inteligencia Artificial</span>
      </h1>

      <p class="hero__lead">
        Construyo productos de punta a punta y hoy lidero una
        <strong>startup de visión por computadora</strong> para tiendas físicas.
        De la idea al deploy en producción.
      </p>

      <div class="hero__cta">
        <a class="btn btn--primary" href="#proyectos">Ver proyectos</a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={`mailto:${site.email}`}>Escribirme</a>
      </div>

      <div class="hero__meta">
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z" /><circle cx="12" cy="10" r="2.6" /></svg>
          {site.location}
        </span>
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1" /><path d="M22 4 12 14l-3-3" /></svg>
          Ingeniería · IA · Visión por computadora
        </span>
        <span class="hero__meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </span>
      </div>
    </div>

    <div class="hero__card">
      <div class="terminal">
        <div class="terminal__bar">
          <span class="terminal__dot terminal__dot--r"></span>
          <span class="terminal__dot terminal__dot--y"></span>
          <span class="terminal__dot terminal__dot--g"></span>
          <span class="terminal__title">julian-africano — zsh</span>
        </div>
        <div class="terminal__body">
          <div class="tline"><span class="ln">01</span><span class="kw">const</span> perfil = &#123;</div>
          <div class="tline"><span class="ln">02</span>&nbsp;&nbsp;<span class="fn">nombre</span>: <span class="st">'Ingeniero de Sistemas'</span>,</div>
          <div class="tline"><span class="ln">03</span>&nbsp;&nbsp;<span class="fn">stack</span>: [<span class="st">'Full-Stack'</span>, <span class="st">'IA'</span>, <span class="st">'Visión'</span>],</div>
          <div class="tline"><span class="ln">04</span>&nbsp;&nbsp;<span class="fn">tecnologias</span>:</div>
          <div class="tline"><span class="ln">05</span>&nbsp;&nbsp;&nbsp;&nbsp;[<span class="st">'Python'</span>, <span class="st">'Django'</span>, <span class="st">'React'</span>,</div>
          <div class="tline"><span class="ln">06</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="st">'Spring Boot'</span>, <span class="st">'YOLOv8'</span>],</div>
          <div class="tline"><span class="ln">07</span>&nbsp;&nbsp;<span class="fn">proyectos</span>: [</div>
          <div class="tline"><span class="ln">08</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="st">'vision-analytics'</span>, <span class="st">'SysteFarma'</span>,</div>
          <div class="tline"><span class="ln">09</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="st">'Asistencia GABO'</span>, ...],</div>
          <div class="tline"><span class="ln">10</span>&nbsp;&nbsp;<span class="fn">objetivo</span>: <span class="st">'aportar valor real'</span><span class="cursor"></span></div>
          <div class="tline"><span class="ln">11</span>&#125;;</div>
          <div class="tline"><span class="ln">12</span><span class="cm"># build en curso…</span> <span class="ok">✓ listo</span></div>
        </div>
      </div>
    </div>
  </div>
</section>